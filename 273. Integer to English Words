class Solution {

    String[] one = {
        "", "One", "Two", "Three", "Four",
        "Five", "Six", "Seven", "Eight", "Nine",
        "Ten", "Eleven", "Twelve", "Thirteen",
        "Fourteen", "Fifteen", "Sixteen",
        "Seventeen", "Eighteen", "Nineteen"
    };

    String[] ten = {
        "", "", "Twenty", "Thirty", "Forty",
        "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"
    };

    public String numberToWords(int num) {
        if (num == 0)
            return "Zero";

        int[] value = {1000000000, 1000000, 1000, 1};
        String[] name = {"Billion", "Million", "Thousand", ""};

        String ans = "";

        for (int i = 0; i < 4; i++) {
            int part = num / value[i];

            if (part > 0) {
                ans += helper(part) + " " + name[i] + " ";
                num %= value[i];
            }
        }

        return ans.trim().replaceAll("\\s+", " ");
    }

    public String helper(int n) {
        if (n < 20)
            return one[n];

        if (n < 100)
            return ten[n / 10] + " " + helper(n % 10);

        return one[n / 100] + " Hundred " + helper(n % 100);
    }
}
